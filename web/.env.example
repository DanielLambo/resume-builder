# Copy to web/.env.local for Next.js / Vercel

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

GROQ_API_KEY=gsk_your_key_here
# GROQ_BASE_URL=https://api.groq.com/openai
# Strong default for vibe coding LaTeX resumes:
# RESUMATE_MODEL=llama-3.3-70b-versatile
# Optional higher-quality Groq model when available on your plan:
# RESUMATE_MODEL=openai/gpt-oss-120b
# RESUMATE_MAX_TOKENS=8192
# RESUMATE_TEMPERATURE=0.35

# Offline / CI / safe demo fallback: synthetic Groq (no live AI).
# Set false only when GROQ_API_KEY (+ preferably Upstash) are configured.
NEXT_PUBLIC_USE_MOCK_AI=true

# LaTeX → PDF (Vercel cannot run pdflatex natively)
# DEMO/PROD CHECKLIST: without one of these, PDF preview fails on Vercel.
#   1) LATEX_COMPILE_URL=https://your-fastapi-host.example   (preferred)
#   2) ALLOW_LATEX_ONLINE=1                                   (demo only — sends PII)
# Local `next dev` can use system pdflatex when RESUMATE_USE_LOCAL_PDFLATEX is not 0.
# LATEX_COMPILE_URL=https://your-fastapi-host.example
#
# Do NOT enable latexonline in production unless you accept sending full resume
# LaTeX (names, emails, employers) to a third party and disclose that to users.
# ALLOW_LATEX_ONLINE=0
# LATEX_ONLINE_URL=https://latexonline.cc/compile
# LATEX_COMPILE_TIMEOUT_MS=8000
# ONE_PAGE_LOCK_TIMEOUT_MS=28000
# RESUMATE_USE_LOCAL_PDFLATEX=1
# DISABLE_GROQ_CONDENSE=1

# Optional Playwright authenticated flow
# E2E_USER_EMAIL=you@example.com
# E2E_USER_PASSWORD=your-test-password
