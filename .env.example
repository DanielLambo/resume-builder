# Resumate — environment template (never commit real keys)

Copy to `.env` (Python) and/or `web/.env.local` (Next.js). All secrets stay
server-side except the intentional `NEXT_PUBLIC_*` Supabase anon values.

# ── AI (OpenAI-compatible; bring your own key) ──────────────
# Any of these key names work (first match wins):
GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_API_KEY=

# Optional base URL override (default: Groq OpenAI-compatible endpoint)
# GROQ_BASE_URL=https://api.groq.com/openai
# OPENAI_BASE_URL=https://api.openai.com
# AI_BASE_URL=http://127.0.0.1:11434/v1

# Model id must match the provider you pointed at
# RESUMATE_MODEL=openai/gpt-oss-20b

# ── Next.js / Vercel (web/) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stable public origin for auth redirects (your deployment, not localhost)
NEXT_PUBLIC_SITE_URL=https://your-app.example.com

UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Offline / CI synthetic AI (no provider calls)
NEXT_PUBLIC_USE_MOCK_AI=false

# LaTeX → PDF (required on Vercel; local next dev can use system pdflatex)
# LATEX_COMPILE_URL=https://your-fastapi-host.example
# ALLOW_LATEX_ONLINE=0
# LATEX_ONLINE_URL=https://latexonline.cc
# LATEX_COMPILE_TIMEOUT_MS=8000
# ONE_PAGE_LOCK_TIMEOUT_MS=28000
# RESUMATE_USE_LOCAL_PDFLATEX=1
# DISABLE_AI_CONDENSE=1

# ── Python FastAPI (optional local) ─────────────────────────
# RESUMATE_HOST=0.0.0.0
# RESUMATE_PORT=8000
# RESUMATE_RELOAD=0
# RESUMATE_PUBLIC=1

# Optional Playwright authenticated flow
# E2E_USER_EMAIL=you@example.com
# E2E_USER_PASSWORD=your-test-password
